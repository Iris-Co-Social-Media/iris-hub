# Copiá este archivo como .env.local para correr el sitio en tu compu.
# .env.local NO se sube a GitHub. En Cloudflare, estas mismas dos variables se
# cargan en la configuración del proyecto (ver docs/INGRESO.md).
#
# SOLO datos públicos: la dirección del proyecto y su clave PÚBLICA
# (Supabase → Project Settings → API Keys → "Publishable key", o la "anon key"
# del formato viejo). NUNCA la "secret key" ni la "service_role".
#
# Por ahora apuntan a iris-pruebas. Para pasar a producción se cambian estos
# dos valores por los de iris-prod; no hace falta tocar el código.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
